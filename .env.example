# Bootstrap-only secrets read from the workstation by `task provision-vault-secrets`
# and written into Vault. Copy to `.env` (gitignored) and fill in.
#
# CLOUDFLARE_API_TOKEN is seeded to kv/alarmify/<env>/cloudflared/token (field `token`)
# and consumed by external-dns via templates/cloudflare-api-token-secret.yaml.
# Create it at https://dash.cloudflare.com -> My Profile -> API Tokens with
# Zone:Read + DNS:Edit scoped to jrclabs.xyz.
CLOUDFLARE_API_TOKEN=
